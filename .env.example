# Postgres connection string. On Railway, this is provided by the Postgres plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/battlebros"

# Groq API key for LLM calls (sanity gate, profile derivation, fight narration).
GROQ_API_KEY="gsk_..."

# Optional: override the default LLM model.
# LLM_MODEL="llama-3.3-70b-versatile"

# Cookie-signing secret for session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Bearer token the nightly cron must send to /api/cron/refresh-traits.
# Required in production; in development the route is open if unset.
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-string"
