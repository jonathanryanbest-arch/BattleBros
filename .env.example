# Postgres connection string. On Railway, this is provided by the Postgres plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/battlebros"

# Anthropic API key for Claude calls (sanity gate, profile derivation, fight narration).
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the default Claude model.
# CLAUDE_MODEL="claude-sonnet-4-6"

# Cookie-signing secret for session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
